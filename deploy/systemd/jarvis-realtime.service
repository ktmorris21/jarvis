[Unit]
Description=Jarvis Realtime Voice — wake word and OpenAI direct audio
Wants=network-online.target
After=network-online.target sound.target
# The legacy listener and Realtime must never own the microphone together.
Conflicts=jarvis-voice.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=shadowfax
Group=shadowfax
WorkingDirectory=/home/shadowfax/jarvis
Environment=HOME=/home/shadowfax
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/jarvis/voice.env
ExecStart=/home/shadowfax/jarvis/.venv-voice/bin/python3 -u /home/shadowfax/jarvis/clients/voice/realtime_conversation.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
