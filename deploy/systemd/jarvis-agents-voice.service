[Unit]
Description=Jarvis Agents SDK chained voice — wake word, STT, agent, TTS
Wants=network-online.target
After=network-online.target sound.target
Conflicts=jarvis-realtime.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=shadowfax
Group=shadowfax
WorkingDirectory=/home/shadowfax/jarvis
Environment=HOME=/home/shadowfax
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/jarvis/voice.env
ExecStart=/home/shadowfax/jarvis/.venv-voice/bin/python3 -u /home/shadowfax/jarvis/clients/voice/voice_interface.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
